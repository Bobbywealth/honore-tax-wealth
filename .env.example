# Postgres connection string. Set to the Render internal hostname in production.
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Salt for IP hashing in consultation rate-limit logs.
LOG_SALT="change-me-with-a-long-random-string"

# Bootstrap administrator. Used ONLY when the users table is empty, to create
# the first admin account on first sign-in. At least 12 characters. After the
# account exists these are ignored — change or remove them afterwards.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-with-a-long-random-password"

# Optional demo client account, created on the first login attempt when the
# env vars are set and no user with that email already exists. At least 12
# characters. Leave either blank to skip client bootstrap entirely.
CLIENT_EMAIL=""
CLIENT_PASSWORD=""

# --- Transactional email (Resend, GitHub #13) -----------------------------
# Both must be set for consultation email to send. If either is missing the
# submission is still stored and the endpoint still returns 201 — email is
# never load-bearing. Until they are set, logEvent("consult.email") reports
# reason="not_configured".
#
# EMAIL_FROM must be a domain you have verified in Resend, e.g.
#   "Honoré Tax & Wealth <notifications@yourdomain.com>"
# Do not use the Resend onboarding address (@onboarding@resend.dev) in
# production: it only delivers to your own account inbox.
RESEND_API_KEY=""
EMAIL_FROM=""

# Where practice-side new-lead notifications are delivered. Falls back to
# ADMIN_EMAIL when unset, so you can leave it blank until you have a real
# mailbox. Replies to the client confirmation go here.
CONSULTATION_NOTIFY_EMAIL=""

# --- Dev-only "Quick login" buttons on /login (TEMPORARY) ------------------
# When all four are set, the /login page renders two one-click buttons
# ("Sign in as Admin" / "Sign in as Client") that auto-fill and submit the
# form with these credentials. Leave any of the four blank to hide both
# buttons. Remove the block (or all four vars) once finished with the
# placeholder dev accounts. NEXT_PUBLIC_ vars are bundled into the client
# JS — do NOT put real production secrets here, only throwaway test creds.
NEXT_PUBLIC_QUICK_ADMIN_EMAIL=""
NEXT_PUBLIC_QUICK_ADMIN_PASSWORD=""
NEXT_PUBLIC_QUICK_CLIENT_EMAIL=""
NEXT_PUBLIC_QUICK_CLIENT_PASSWORD=""

# --- Future Phase 2 secrets (placeholders, not yet used) --------------------
# AUTH_SECRET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""